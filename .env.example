NODE_ENV=development
PORT=8080
APP_TIMEZONE=Europe/Paris
SUPABASE_URL=https://kqgfeusiwvycpuvecgab.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Yahoo : aucune clé API nécessaire ; variable réservée aux autres adaptateurs.
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=
BENCHMARK_PROVIDER_SYMBOL=IWDA.AS
UNIVERSE_CONFIG_PATH=./config/universe.json
HISTORY_LOOKBACK_DAYS=550
MARKET_TIMEOUT_MS=15000
MARKET_RETRIES=3
MARKET_DELAY_MS=250
MAX_PRICE_AGE_DAYS=4

PAPER_TRADING=true
TRADING_MODE=PAPER_TRADING
DRY_RUN=true
PAPER_FEE_EUR=0
RISK_PROFILE=AGGRESSIVE
STOP_REVIEW_PCT=-18
TAKE_PROFIT_REVIEW_PCT=25
COOLDOWN_DAYS=7

# Transport email toujours désactivé pour cette étape.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
